# Copy this file to .env (git-ignored) only if you refresh the NASA data on your own machine.
# The game itself needs no keys and makes no network calls.

# NASA_API_KEY: optional, used only by `npm run data:fetch` (scripts/fetch-donki.mjs).
# Without it the script uses NASA's rate-limited DEMO_KEY. Get a free key at https://api.nasa.gov.
# Run with the key loaded:  node --env-file=.env scripts/fetch-donki.mjs
NASA_API_KEY="YOUR_NASA_API_KEY"
